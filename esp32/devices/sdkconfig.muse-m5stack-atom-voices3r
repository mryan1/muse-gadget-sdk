# M5Stack Atom VoiceS3R / Atom EchoS3R (C126): ESP32-S3-PICO-1-N8R8 (8 MB
# flash, 8 MB octal PSRAM), ES8311 codec with one mic, NS4150B speaker amp,
# the front button, no screen, no LED, no battery. Console on the S3's own
# USB-Serial-JTAG (303a:1001). Pins from M5Unified; see
# components/muse/boards/board_m5stack_atom_voices3r.c. Load last, after
# sdkconfig.muse.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_MUSE_BOARD_M5STACK_ATOM_VOICES3R=y
# Ignored by boards with the full UI (the talk button confirms pairing); set
# to the front button for the record.
CONFIG_HOMEHUB_BUTTON_GPIO=41
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_muse_8mb.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# Octal PSRAM: the PICO-1-N8R8 faults in quad mode.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# As on the StickS3 and AIPI: static buffers in PSRAM, or BLE setup can't find
# 8 KB of internal RAM for its task.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# CONFIG_SPIRAM_IGNORE_NOTFOUND is not set
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
# The 128 px layout's captions (the UI is laid out, though never shown).
CONFIG_LV_FONT_MONTSERRAT_12=y

# Always on USB power, so no PM/light-sleep block: nothing to save, and the
# audio path stays at full clock.

# With no screen, replies are heard or not at all: tap the button for a live
# call with Muse (spoken replies), hold it for a voice note (text reply in the
# Muse app).
CONFIG_MUSE_REALTIME_VOICE=y
